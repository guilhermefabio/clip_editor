# Copie para studio/youtube/secrets/youtube.env (ou exporte no ambiente).
# NUNCA versione o arquivo preenchido.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Opcional: se vazio, usa mine=true (canal da conta autenticada).
YOUTUBE_CHANNEL_ID=

# Opcional: pesos do quality_score (JSON). Ex.:
# YOUTUBE_QUALITY_WEIGHTS={"retention":0.4,"engaged_view_rate":0.25,"engagement":0.2,"subscriber_conversion":0.15}
